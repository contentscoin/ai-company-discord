# Compose configuration — copy to .env. Contains NO secrets (tokens live in secrets/*.env).

# Upstream version pins. Upgrading is a one-line change here.
HERMES_REF=main                 # git ref of NousResearch/hermes-agent to build
PAPERCLIP_VERSION=latest        # npm version of paperclipai
NODE_TAG=20-bookworm-slim       # node image for the Paperclip service

# File ownership inside the Hermes containers (match your host user to avoid
# root-owned volume files): id -u / id -g
HERMES_UID=10000
HERMES_GID=10000
