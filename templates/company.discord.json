{
  "$schema": "./company.schema.json",
  "name": "solo-founder-discord",
  "version": "0.5.0",
  "protocolVersion": "1",
  "meetingChannel": "discord",
  "hotlineChannel": "telegram-dm-optional",
  "controlPlane": "paperclip",
  "knowledge": {
    "primary": "opencrab",
    "ingestSkill": "workmate-opencrab-ingest",
    "profileEqualsProject": true
  },
  "devCenter": {
    "primary": "cursor",
    "satellites": [
      "codex",
      "claude"
    ],
    "gjcDefaultBundle": "daily",
    "frameworks": [
      {
        "name": "akanjs",
        "kind": "fullstack-ts",
        "status": "candidate",
        "ref": "https://github.com/akan-team/akanjs",
        "note": "Bun+React+SQLite, schema SSoT -> API -> UI codegen; ships web/mobile/server from one TS source. Provides AI-agent guideline generation."
      }
    ]
  },
  "meetings": {
    "timezone": "Asia/Seoul",
    "standupCron": "0 9 * * 1-5",
    "execMeetingCron": "0 10 * * 1"
  },
  "roles": [
    {
      "id": "ceo",
      "title": "CEO",
      "hermesProfile": "ceo",
      "discordBot": "AI-CEO",
      "gjcRole": "default",
      "runtime": "hermes",
      "modelHint": "anthropic/opus"
    },
    {
      "id": "cto",
      "title": "CTO",
      "hermesProfile": "cto",
      "discordBot": "AI-CTO",
      "gjcRole": "executor",
      "runtime": "cursor",
      "satellites": [
        "codex",
        "claude"
      ],
      "modelHint": "cursor (codex/claude satellites)"
    },
    {
      "id": "loop",
      "title": "Loop Engineer",
      "hermesProfile": "loop",
      "discordBot": "AI-Loop",
      "gjcRole": "architect",
      "runtime": "hermes",
      "modelHint": "gemini/opus-longform"
    },
    {
      "id": "growth",
      "title": "Growth Lead",
      "hermesProfile": "growth",
      "discordBot": "AI-Growth",
      "gjcRole": null,
      "runtime": "hermes",
      "modelHint": "anthropic/sonnet"
    },
    {
      "id": "critic",
      "title": "Critic",
      "hermesProfile": "critic",
      "discordBot": "AI-Critic",
      "gjcRole": "critic",
      "runtime": "hermes",
      "crossFamily": true,
      "modelHint": "cross-family"
    }
  ],
  "discord": {
    "requireMention": true,
    "autoThread": true,
    "categories": [
      "board",
      "meetings",
      "work",
      "knowledge"
    ],
    "channels": [
      {
        "name": "board-you",
        "category": "board",
        "purpose": "당신 ↔ CEO 전략 1:1에 가까운 공개 보드",
        "access": [
          "board",
          "ceo"
        ]
      },
      {
        "name": "approvals",
        "category": "board",
        "purpose": "예산·채용·배포·발행 승인 (해당 본부장은 안건별로 초대)",
        "access": [
          "board",
          "ceo"
        ]
      },
      {
        "name": "exec-meeting",
        "category": "meetings",
        "purpose": "주간/임시 임원 회의 (스레드=안건)",
        "access": [
          "board",
          "exec"
        ]
      },
      {
        "name": "standup",
        "category": "meetings",
        "purpose": "매일 비동기 스탠드업 (cron 자동 포스트 허용 채널)",
        "access": [
          "exec"
        ],
        "freeResponse": true
      },
      {
        "name": "war-room",
        "category": "meetings",
        "purpose": "장애·위기·비가역 결정",
        "access": [
          "board",
          "ceo",
          "cto",
          "critic"
        ]
      },
      {
        "name": "dev",
        "category": "work",
        "purpose": "구현·PR·Cursor/Codex 알림",
        "access": [
          "cto",
          "loop",
          "critic"
        ]
      },
      {
        "name": "loop",
        "category": "work",
        "purpose": "DoD·VALIDATION·리뷰 루프",
        "access": [
          "loop",
          "cto",
          "critic"
        ]
      },
      {
        "name": "growth",
        "category": "work",
        "purpose": "SNS·캘린더·콘텐츠",
        "access": [
          "growth",
          "ceo"
        ]
      },
      {
        "name": "paperclip-feed",
        "category": "work",
        "purpose": "Paperclip 이슈 알림 미러 (선택)",
        "access": [
          "exec"
        ],
        "optional": true
      },
      {
        "name": "ingest-review",
        "category": "knowledge",
        "purpose": "OpenCrab manual-review 후보 논의",
        "access": [
          "board",
          "ceo"
        ]
      },
      {
        "name": "briefs",
        "category": "knowledge",
        "purpose": "주간 CEO 브리핑 아카이브",
        "access": [
          "board",
          "exec"
        ]
      }
    ]
  },
  "references": [
    "https://github.com/project820/gjc-multivendor-setup-guide",
    "https://github.com/paperclipai/paperclip",
    "https://github.com/NousResearch/hermes-agent",
    "https://github.com/contentscoin/workmate-opencrab-ingest-skill",
    "https://github.com/akan-team/akanjs",
    "https://github.com/NousResearch/hermes-paperclip-adapter",
    "https://github.com/contentscoin/hermes-ceo-console-installer",
    "https://github.com/contentscoin/social-ai-team-custom",
    "https://github.com/garrytan/gbrain"
  ]
}
