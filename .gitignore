# Secrets — never commit real tokens
.env
**/.env
!.env.example
# Compose per-profile token files (secrets/ceo.env, …) — examples only are tracked
secrets/*.env
!secrets/*.env.example

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.pyc

# Machine-specific probe output from `companyctl verify-runtime`.
# Commit it deliberately once the contract is settled for your pinned ref.
RUNTIME-CONTRACT.md
CURSOR-CONTRACT.md

*.log
